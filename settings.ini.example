[settings]
ENV=development
DEBUG=True

# Database
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# Redis
REDIS_HOST=
REDIS_PORT=

# Auth
SECRET_KEY=
SESSION_COOKIE_NAME=

# App
BIND=

# Logging
LOG_DIR=
LOG_LEVEL=

# API Docs
API_TITLE=Markt API
API_VERSION=v1
OPENAPI_VERSION=3.0.3
OPENAPI_URL_PREFIX=/
OPENAPI_SWAGGER_UI_PATH=/swagger-ui
OPENAPI_SWAGGER_UI_URL=https://cdn.jsdelivr.net/npm/swagger-ui-dist/

# CORS / Cookies
ALLOWED_ORIGINS=http://localhost:3000,https://test.marktcommerce.com

# Cookie settings (set these for HTTPS cross-site in production)
# For cross-site cookies over HTTPS, set SAMESITE=None and SECURE=True
SESSION_COOKIE_SAMESITE=
SESSION_COOKIE_SECURE=

# Paystack Configuration
PAYSTACK_SECRET_KEY=sk_test_your_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here
PAYMENT_CURRENCY=NGN
PAYMENT_GATEWAY=paystack

# Store-review demo rider: this phone number always gets this six-digit code
# and nothing is sent. Leave both empty to have no demo account.
DELIVERY_DEMO_PHONE=
DELIVERY_DEMO_OTP=

# Rider sign-in codes: channels tried in order (sms, email). SMS is Termii
# and needs an API key and an approved sender ID; channel dnd is
# transactional. The base URL is per account (Termii dashboard).
OTP_CHANNELS=email
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_CHANNEL=dnd
TERMII_BASE_URL=https://v3.api.termii.com

# API & Frontend URLs (for payment callbacks and redirects)
# Development: http://localhost:8000
# Production: https://api.yourdomain.com
API_BASE_URL=http://localhost:8000

# Web app URL (where browser/web users are redirected after payment)
# Development: http://localhost:3000
# Production: https://marktcommerce.com/app
WEB_APP_BASE_URL=http://localhost:3000

# Mobile app deep link scheme (where mobile app users are redirected after payment)
MOBILE_APP_SCHEME=markt://

# AWS Configuration
AWS_ACCESS_KEY=your_aws_access_key_here
AWS_SECRET_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1
AWS_S3_BUCKET=markt-media
CDN_DOMAIN=cdn.yourdomain.com

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@markt.com
RESEND_FROM_NAME=Markt
RESEND_TRANSACTIONAL_FROM_EMAIL=orders@markt.com
RESEND_TRANSACTIONAL_FROM_NAME=Markt Orders
RESEND_NOTIFICATION_FROM_EMAIL=notifications@markt.com
RESEND_NOTIFICATION_FROM_NAME=Markt Notifications
RESEND_MARKETING_FROM_EMAIL=hello@markt.com
RESEND_MARKETING_FROM_NAME=Markt
EMAIL_REPLY_TO=support@markt.com
EMAIL_UNSUBSCRIBE_URL=https://marktcommerce.com/settings/notifications

# Markt Business (see main/config.py). Clients read these via
# GET /api/v1/business/config -- never set them in the frontends.
BUSINESS_MODE_ENABLED=True
BUSINESS_REGISTRATION_ENABLED=True
BUSINESS_DISCOVERY_ENABLED=True
BUSINESS_PROCUREMENT_ENABLED=True
# Off: the is_business tag is free. On: it needs an active subscription whose
# plan grants "business_account". Create plans before turning this on.
BUSINESS_SUBSCRIPTIONS_ENABLED=False
BUSINESS_VERIFICATION_ENABLED=False
