[flake8]
max-line-length = 88
exclude =
    migrations

# Temporary legacy baseline for existing code.
# Goal: tighten this list gradually as modules are cleaned up.
extend-ignore =
    E222,
    E265,
    E302,
    E402,
    E501,
    E712,
    E722,
    F401,
    F541,
    F811,
    F821,
    F841,
    W291,
    W293
