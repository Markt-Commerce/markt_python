# --- Social sign-in (see SETUP_OAUTH.md in markt_mobile) --------------------
# Each value below is an *audience* we accept identity tokens for. A token is
# only trusted if its `aud` matches one of these, which is what stops a token
# minted for another app being replayed against Markt.
#
# Leave them blank and social sign-in returns 503 rather than silently
# accepting anything.

# Google: one client id per platform. All three are accepted because the `aud`
# in the token is the client id of the platform that signed in.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# Apple: `aud` is the bundle identifier for a native iOS sign-in, and the
# Services ID for a web/Android one.
APPLE_BUNDLE_ID=
APPLE_SERVICES_ID=

# Google Maps — server-side Geocoding/Places (see SETUP_MAPS.md in markt_mobile).
# Restrict this key by your server IP; it must never ship in an app binary.
GOOGLE_MAPS_SERVER_KEY=
