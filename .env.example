# ⚠️  THIS REPO READS settings.ini, NOT .env
#
# python-decouple looks for settings.ini first and .env second, and stops at
# the first one it finds. settings.ini exists here, so a value placed only in
# .env is never read -- it does not error, it just silently falls back to the
# default, which is the worst way for configuration to fail.
#
# Proven, not assumed: with DELIVERY_BATCH_ENABLED=true in .env alone the app
# reads MISSING; move the same line to settings.ini and it reads true.
#
# So: copy what you need from here into settings.ini. This file is a
# reference for what exists and what it means, not a file the app loads.
# (Both are gitignored; settings.ini is the one that counts.)
#
# ---------------------------------------------------------------------------

# --- Social sign-in (see SETUP_OAUTH.md in markt_mobile) --------------------
# Each value below is an *audience* we accept identity tokens for. A token is
# only trusted if its `aud` matches one of these, which is what stops a token
# minted for another app being replayed against Markt.
#
# Leave them blank and social sign-in returns 503 rather than silently
# accepting anything.

# Google: one client id per platform. All three are accepted because the `aud`
# in the token is the client id of the platform that signed in.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# Apple: `aud` is the bundle identifier for a native iOS sign-in, and the
# Services ID for a web/Android one.
APPLE_BUNDLE_ID=
APPLE_SERVICES_ID=

# Google Maps — server-side Geocoding/Places (see SETUP_MAPS.md in markt_mobile).
# Restrict this key by your server IP; it must never ship in an app binary.
GOOGLE_MAPS_SERVER_KEY=

# --- Delivery ---------------------------------------------------------------
# Which fleet carries parcels: "internal" (our own riders, the default) or
# "partner_stub" until the partner's real adapter is registered.
LOGISTICS_ADAPTER=internal
# Shared secret for the partner's status webhook (HMAC-SHA512 over the raw
# body). Unset means the endpoint refuses everything, which is the right
# default: an open endpoint that moves parcels through their states is worth
# more to an attacker than it is to us.
LOGISTICS_WEBHOOK_SECRET=
# Paystack gates pre-authorization per merchant AND only supports it for ZAR.
# Markt charges in NGN, so this cannot currently produce a hold whatever it is
# set to -- see docs/ADR-002-batch-delivery.md. Defaults to off.
PAYSTACK_PREAUTH_ENABLED=false
# Batched delivery: several buyers going the same way share one run and split
# the fee, capped so sharing never costs more than going alone. Off until the
# buyer-facing half exists -- the money model alone is not the feature.
DELIVERY_BATCH_ENABLED=false
# How far apart two shops can be and still be collected on one trip. Past
# this, the second pickup is a detour somebody has to be paid for.
DELIVERY_COMBINE_RADIUS_KM=1.5

# Proactive image moderation. Empty (the default) means uploaded images are
# NOT scanned -- moderation is reactive: someone reports, a human acts.
# Setting this switches app/media/moderation.py on, which needs credentials
# for a provider (Cloud Vision SafeSearch, AWS Rekognition) that nobody has
# supplied yet. Leave it empty until one exists, so the logs do not claim
# scanning that is not happening.
IMAGE_MODERATION_PROVIDER=
